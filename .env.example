# ==============================================================================
# VENUE NEXUS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Application Settings
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. PostgreSQL Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=venuenexus_dev
POSTGRES_USER=venuenexus_user
POSTGRES_PASSWORD=replace_with_strong_db_password_in_env
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Ephemeral State)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password_in_env

# ------------------------------------------------------------------------------
# 4. MinIO Object Storage (Local Development S3)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minio_admin_user
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password_in_env
MINIO_BUCKET_NAME=venue-nexus-assets

# ------------------------------------------------------------------------------
# 5. Security & JWT Configuration (Staff Authentication)
# ------------------------------------------------------------------------------
# Secret must be at least 256 bits (32 bytes base64-encoded) for HMAC-SHA256
JWT_SECRET=replace_with_at_least_256_bit_base64_secret_key_in_local_env
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# ------------------------------------------------------------------------------
# 6. RESERVED Configurations (Sprint 2 - 4 Changes / Change Requests)
# Placeholders only. No implementation in Sprint 1 Phase 1.
# Values MUST come from environment in later sprints and NEVER be hardcoded.
# ------------------------------------------------------------------------------
# CR-02: Payment Provider Credentials and Webhook Secrets (Sprint 3)
# PAYMENT_PROVIDER_NAME=placeholder_provider
# PAYMENT_PROVIDER_API_KEY=placeholder_api_key
# PAYMENT_PROVIDER_WEBHOOK_SECRET=placeholder_webhook_secret
# PAYMENT_MODE_DEFAULT=ONLINE_PRE_ACCEPTANCE

# CR-03: AI Provider Credentials & Feature Flags (Sprints 2 & 3, default OFF)
# AI_PROVIDER_NAME=placeholder_ai_provider
# AI_PROVIDER_API_KEY=placeholder_ai_key
# FEATURE_FLAG_AI_RECOMMENDATIONS_ENABLED=false
# FEATURE_FLAG_AI_CHATBOT_ENABLED=false
# FEATURE_FLAG_AI_ROUTING_ENABLED=false

# CR-05: Automatic Logout Trigger Setting (Sprint 2)
# AUTO_LOGOUT_TRIGGER=TRANSACTION_COMPLETE
